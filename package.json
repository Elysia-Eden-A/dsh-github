{
  "name": "@local/dsh-github",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub integration for the agent: sign in once, then create repositories and push from the desktop.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "gh.ps1",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
